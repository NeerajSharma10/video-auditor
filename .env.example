# ==========================================
# Brand Guardian - Environment Configuration
# ==========================================

# Local LLM via Ollama (Free & Local)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma3:1b"

# Local Vector Database (ChromaDB)
CHROMA_PERSIST_DIR="backend/data/chroma_db"
CHROMA_COLLECTION_NAME="compliance_rules"

# Speech-to-Text Model (faster-whisper)
WHISPER_MODEL_SIZE="base.en"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# OCR Settings
OCR_SAMPLE_RATE_SEC=3

# --- LangSmith Observability & Tracing (Optional) ---
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="brand-guardian"
